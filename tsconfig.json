{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "noEmit": true, "experimentalDecorators": true, "emitDecoratorMetadata": true
  },
  "include": ["poc/**/*.ts", "poc/**/*.tsx", "packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "processors/**/*.ts"]
}
