{
  "name": "unified-workbench",
  "version": "0.0.0",
  "private": true,
  "description": "统一管理平台与乾坤财务子系统：可执行规格及开发准备",
  "type": "module",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.20.0"
    },
    "multer": "2.5.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/generate-clients.mjs",
    "db:migrate:test": "node scripts/migrate-test-databases.mjs",
    "test:database": "node tests/database-isolation.integration.mjs",
    "start:platform": "node --import tsx apps/platform-api/src/main.ts",
    "test:auth": "node --import tsx tests/platform-auth.integration.mjs",
    "test:permissions": "node --import tsx tests/platform-permissions.integration.mjs",
    "build:poc": "node scripts/build-poc.mjs",
    "test:poc": "node tests/poc-browser.mjs",
    "spec:check": "node scripts/specctl.mjs check",
    "spec:status": "node scripts/specctl.mjs status",
    "spec:next": "node scripts/specctl.mjs next",
    "spec:task": "node scripts/specctl.mjs task",
    "spec:start": "node scripts/specctl.mjs start",
    "spec:complete": "node scripts/specctl.mjs complete",
    "spec:approve": "node scripts/specctl.mjs approve",
    "acceptance:platform": "node scripts/acceptance.mjs platform",
    "acceptance:finance": "node scripts/acceptance.mjs finance",
    "public:audit": "node scripts/public-audit.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run spec:check && npm test && npm run public:audit"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "css-loader": "7.1.5",
    "html-webpack-plugin": "5.6.8",
    "playwright": "1.64.1",
    "prisma": "6.19.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "6.19.0",
    "antd": "5.29.3",
    "cookie-parser": "1.4.7",
    "dayjs": "1.11.19",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "qiankun": "2.10.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  }
}
